# Copy to .env — never commit .env

# Required: same Cerebras key you configured in the OpenClaw app (hackathon Kimi trial).
# https://cloud.cerebras.ai — model: moonshotai-kimi-k3.1-pro-trial
CEREBRAS_API_KEY=your_cerebras_key_here

# OpenClaw CLI (from desktop app or install). Omit if `openclaw` is already on PATH.
OPENCLAW_BIN=/Users/you/.openclaw/bin/openclaw

# Hackathon default: Gateway harness (port 18789). Use `exec` only if you know you want no Gateway.
OPENCLAW_TRANSPORT=gateway

# Only when OPENCLAW_TRANSPORT=exec
OPENCLAW_CONFIG=/Users/you/.openclaw/openclaw.json

# Per OpenClaw agent turn (seconds)
OPENCLAW_TIMEOUT=28

# Node API port + HTTP ceiling while waiting for OpenClaw (milliseconds)
RIVAL_PORT=8787
RIVAL_HTTP_TIMEOUT=55000

# Cerebras 429 / overload: server tells client how long to back off (milliseconds)
RIVAL_RATE_LIMIT_BACKOFF_MS=22000
RIVAL_RATE_LIMIT_RETRY_MS=4000

# Optional: browser → remote patch API (e.g. Mac host IP:8787)
# VITE_RIVAL_API=http://192.168.1.10:8787