# Copy to .env — never commit .env

# Required: Cerebras Cloud API key (Kimi K3.1 Pro private preview for hackathon)
# https://cloud.cerebras.ai
CEREBRAS_API_KEY=your_cerebras_key_here

# Required: OpenClaw CLI (hackathon harness)
OPENCLAW_BIN=/Users/you/.openclaw/bin/openclaw

# Default for demos/judging: OpenClaw Gateway + openclaw agent (hackathon standard harness)
OPENCLAW_TRANSPORT=gateway

# Only used when OPENCLAW_TRANSPORT=exec (optional dev fallback; still OpenClaw)
OPENCLAW_CONFIG=/Users/you/.openclaw/openclaw.json

OPENCLAW_TIMEOUT=28
RIVAL_PORT=8787